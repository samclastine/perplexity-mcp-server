# Copy this file to .env and fill in your values. Do not commit .env.

# Required: Perplexity API key
PERPLEXITY_API_KEY=your_api_key_here

# Optional: model selection (defaults to "sonar")
# Options: sonar | sonar-pro | sonar-reasoning | sonar-reasoning-pro | sonar-deep-research | r1-1776
PERPLEXITY_MODEL=sonar

